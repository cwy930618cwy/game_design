// 整个 .uproject 是一个 JSON 对象，从这里开始
{
	// .uproject 格式版本号；UE5 固定写 3，写错引擎不认
	"FileVersion": 3,
	// 绑定本机注册的 UE 5.4；双击工程时引擎按这个版本启动
	"EngineAssociation": "5.4",
	// 启动器里的分类标签，纯展示用，不影响编译
	"Category": "Samples",
	// 工程描述，纯展示用，留空即可
	"Description": "",
	// 代码模块数组；每一项对应 Source\ 下的一个目录
	"Modules": [
		// 第 1 个模块对象开始
		{
			// 模块名；引擎据此去 Source\LyraGame\ 找 LyraGame.Build.cs
			"Name": "LyraGame",
			// 模块类型：Runtime = 运行时模块，会打包进游戏
			"Type": "Runtime",
			// 加载时机：Default = 引擎启动时加载
			"LoadingPhase": "Default",
			// 额外的 UHT 依赖；让这些模块的反射代码先生成
			"AdditionalDependencies": [
				// 开发者设置模块；Lyra 的 ULyraDeveloperSettings 依赖它
				"DeveloperSettings",
				// 引擎主体模块；几乎所有 UCLASS 都间接依赖它
				"Engine"
			]
		}
	],
	// Modules 数组结束（S00 只有 LyraGame；LyraEditor 在 S22 补回）
	// 插件数组；每一项是一个插件开关
	"Plugins": [
		// ── 1 ── 引擎插件 ──
		{
			// Actor 调色板：编辑器里把常用 Actor 存成面板，一键拖进场景
			"Name": "ActorPalette",
			"Enabled": true
		},
		// ── 2 ── 引擎插件 ──
		{
			// 网络加密组件（AES-GCM 算法），防抓包篡改
			"Name": "AESGCMHandlerComponent",
			"Enabled": true
		},
		// ── 3 ── 引擎插件 ──
		{
			// 网络加密组件（DTLS 协议），用于语音 / UDP 加密
			"Name": "DTLSHandlerComponent",
			"Enabled": true
		},
		// ── 4 ── 引擎插件 ──
		{
			// ★ GAS 插件：技能、属性、GameplayEffect、GameplayCue 全在这
			"Name": "GameplayAbilities",
			"Enabled": true
		},
		// ── 5 ── 引擎插件 ──
		{
			// 自动化测试框架，CI 无人值守跑测试用
			"Name": "Gauntlet",
			"Enabled": true
		},
		// ── 6 ── ★ 本机没有此插件（靠 Optional 豁免）──
		{
			// D3D 外接显卡性能统计
			"Name": "D3DExternalGPUStatistics",
			"Enabled": true,
			// ★ 关键：Optional=true → 本机找不到也不报错
			"Optional": true,
			// 仅在下列平台启用
			"SupportedTargetPlatforms": [
				// 仅 Windows 64 位
				"Win64"
			]
		},
        // ── 7 ── 引擎插件 ──
        {
            // NPC 对话树系统 
            "Name": "CommonConversation",
			"Enabled": true
        },
        // ── 8 ── 引擎插件 ──
        {
            // GameFeatures 机制： 把玩法做成可插拔
			"Name": "GameFeatures",
			"Enabled": true
		},
        // ── 9 ── 引擎插件 ──
		{
			// 模块化 GamePlay: 提供UGameFrameworkComponentManager 和初始化状态机
			"Name": "ModularGameplay",
			"Enabled": true
		},
		{
			// 10 增强输入系统：UinputAction / UInputMappingContext
			"Name": "EnhancedInput",
			"Enabled": true
		},
		{
			// 11 手柄支持： 
			"Name": "WinDualShock",
			"Enabled": true,
			"SupportedTargetPlatforms": [
				"Win64"
			]
		},
		{
			// 12 体积云
			"Name": "Volumetrics",
			"Enabled": true
		},
		{
			// 13 数据注册表： 按ID查资产， Lyra 用它管理 GameplayCue
			"Name": "DataRegistry",
			"Enabled": true
		},
		{
			// 14 网络复制图：按空间网格觉得谁同步谁，省带宽
			"Name": "ReplicationGraph",
			"Enabled": true
		},
		{
			// 15 重要性管理器： 远处Actor降频更新
			"Name": "SignificanceManager",
			"Enabled": true
		},
		{
			// 16 粒子系统（VFX）
			"Name": "Niagara",
			"Enabled": true
		},
		{
			// 17 水体系统： 
			"Name": "Water",
			"Enabled": true
		},
		{
			// 18 CommonUI 框架：手柄 / 键鼠 / 触屏统一的UI输入与焦点管理
			"Name": "CommonUI",
			"Enabled": true
		},
		{
			// 19 控制流：节点图执行框架
			"Name": "ControlFlows",
			"Enabled": true
		},
		{
			// 20 新一代音频引擎
			"Name": "Metasound",
			"Enabled": true
		},
		// ── 21 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// MagicLeap AR 平台支持（UE5.4 起已从引擎移除）
			"Name": "MagicLeap",
			// 禁用：条目保留以便对照 Lyra；禁用状态引擎不查，本机没有也不报错
			"Enabled": false
		},
		// ── 22 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// MagicLeap 媒体播放（已移除）
			"Name": "MagicLeapMedia",
			"Enabled": false
		},
		// ── 23 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// MagicLeap 可通行世界（已移除）
			"Name": "MagicLeapPassableWorld",
			"Enabled": false
		},
		// ── 24 ── 引擎插件 ──
		{
			// OpenXR 眼动追踪
			"Name": "OpenXREyeTracker",
			"Enabled": false
		},
		// ── 25 ── 引擎插件 ──
		{
			// OpenXR 手部追踪
			"Name": "OpenXRHandTracking",
			"Enabled": false
		},
		// ── 26 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// OpenXR 头显（UE5.4 已合并进 OpenXR 主插件）
			"Name": "OpenXRHMD",
			"Enabled": false
		},
		// ── 27 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// SteamVR 支持（5.4 已改为可选分发）
			"Name": "SteamVR",
			"Enabled": false
		},
		// ── 28 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// 三星 GearVR 支持（已废弃）
			"Name": "GearVR",
			"Enabled": false
		},
		// ── 29 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// MagicLeap Lumin 平台特性（已废弃）
			"Name": "LuminPlatformFeatures",
			"Enabled": false,
			"SupportedTargetPlatforms": [
				// 仅 Lumin 平台
				"Lumin"
			]
		},
		// ── 30 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// MagicLeap SDK（已移除）
			"Name": "MLSDK",
			"Enabled": false
		},
		{
			// 31 在线框架： 大厅、绘画、匹配
			"Name": "OnlineFramework",
			"Enabled": false
		},
		// ── 32 ── ★ 本机没有此插件（平台白名单豁免）──
		{
			// PlayFab 语音 / 网络
			"Name": "PlayFabParty",
			"Enabled": true,
			// ★ 关键：只有 XB1 / XSX 允许启用 → Win64 下引擎直接跳过，本机没有也不报错
			"PlatformAllowList": [
				// Xbox One
				"XB1",
				// Xbox Series X
				"XSX"
			],
			"SupportedTargetPlatforms": [
				"XB1",
				"XSX"
			]
		},
		// ── 33 ── 引擎插件 ──
		{
			// Epic Online Services 旧接口（OnlineSubsystem 系列）
			"Name": "OnlineSubsystemEOS",
			"Enabled": true
		},
		{
			// 34 EOS 新街口 
			"Name": "OnlineServicesEOS",
			"Enabled": true
		},
		// ── 35 ── 引擎插件 ──
		{
			// 空实现：离线测试用，不连任何在线服务
			"Name": "OnlineServicesNull",
			"Enabled": true
		},
		// ── 36 ── 引擎插件 ──
		{
			// 把旧 OSS 接口适配到新 OnlineServices
			"Name": "OnlineServicesOSSAdapter",
			"Enabled": true
		},
		{
			// 37 steam 平台接口
			"Name": "OnlineSubsystemSteam",
			"Enabled": true
		},
		// ── 38 ── 引擎插件 ──
		{
			// Steam 网络套接字
			"Name": "SteamSockets",
			"Enabled": true
		},
		// 一下9项是工程插件
		{
			// 39 通用加载界面：ILoadingProcessInterface
			// 来源：Plugins\CommonLoadingScreen
			"Name": "CommonLoadingScreen",
			"Enabled": true
		},
		{
			// 40 模块化玩法 Actor: AModularPawn / AModularCharacter
			// 来源：Plugins\ModularGameplayActoors
			"Name": "ModularGameplayActors",
			"Enabled": true
		},
		{
			// 41 设置系统：GameSetting
			// 来源：Plugins\GameSettings
			"Name": "GameSettings",
			"Enabled": true
		},
		{
			// 42 通用用户系统：登录 / 会话 / 在线服务封装
			// 来源：Plugins\CommonUser
			"Name": "CommonUser",
			"Enabled": true
		},
		{
			// 43 通用游戏层：GameInstance / UI策略 / UI 管理层栈
			// 来源：Plugins\CommonGame
			"Name": "CommonGame",
			"Enabled": true
		},
		{
			// 44 字幕系统： SSubtitleDisplay
			// 来源：Plugins\GameSubtitles
			"Name": "GameSubtitles",
			"Enabled": true
		},
		{
			// 45 UI扩展点：UIExtensionPointWidget, 允许玩法模块往 HUD 里插控件
			// 来源：Plugins\UIExtension
			"Name": "UIExtension",
			"Enabled": true
		},
		{
			// 46 异步Mixin: AsyncTask 组合工具
			// 来源：Plugins\AsyncMixin
			"Name": "AsyncMixin",
			"Enabled": true
		},
		{
			// 47 玩法消息路由：GameplayMessageSubsystem 
			// 来源: Plugins\GameplayMessageRouter
			"Name": "GameplayMessageRouter",
			"Enabled": true
		},
		// ══════════ 以下回到引擎插件 ══════════
		{
			// 48 资产引用限制规则：防止跨模块乱引用
			"Name": "AssetReferenceRestrictions",
			"Enabled": true
		},
		{
			// 49 建模工具编辑器模式
			"Name": "ModelingToolsEditorMode",
			"Enabled": true
		},
		{
			// 50 几何脚本：程序化建模
			"Name": "GeometryScripting",
			"Enabled": true
		},
		{
			// 51 动画移动库： 步态混合
			"Name": "AnimationLocomotionLibrary",
			"Enabled": true
		},
		// ── 52 ── 引擎插件 ──
		{
			// 音频调制：参数化混音
			"Name": "AudioModulation",
			"Enabled": true
		},
		// ── 53 ── 引擎插件 ──
		{
			// 音频玩法体积：区域混响
			"Name": "AudioGameplayVolume",
			"Enabled": true
		},
		// ── 54 ── 引擎插件 ──
		{
			// 音频玩法组件
			"Name": "AudioGameplay",
			"Enabled": true
		},
		// ── 55 ── 引擎插件 ──
		{
			// 音频工具函数库
			"Name": "SoundUtilities",
			"Enabled": true
		},
		{
			// 56 动画扭曲：脚部贴地、朝向修正
			"Name": "AnimationWarping",
			"Enabled": true
		},
		{
			// 57 影片渲染管线：离线出片
			"Name": "MovieRenderPipeline",
			"Enabled": true
		},
		// ── 58 ── 引擎插件 ──
		{
			// 影片渲染的遮罩通道
			"Name": "MoviePipelineMaskRenderPass",
			"Enabled": true
		},
		{
			// 59 资产搜索
			"Name": "AssetSearch",
			"Enabled": true
		},
		{
			// 60 编辑器里可视化 GAS 运行状态
			"Name": "GameplayInsights",
			"Enabled": true
		},
		// ── 61 ── 引擎插件 ──
		{
			// Google Resonance 空间音频
			"Name": "ResonanceAudio",
			"Enabled": false
		},
		// ── 62 ── ★ 本机没有此插件（Enabled=false 豁免）──
		{
			// 运行时 PhysX 烘焙（UE5 默认 Chaos，已移除）
			"Name": "RuntimePhysXCooking",
			"Enabled": false
		},
		// ── 63 ── 引擎插件 ──
		{
			// 空间音频
			"Name": "Spatialization",
			"Enabled": true
		},
		{
			// 64 功能测试编辑器
			"Name": "FunctionalTestingEditor",
			"Enabled": true
		},
		{
			// 65 玩法交互框架
			"Name": "GameplayInteractions",
			"Enabled": true
		},
		{
			// 66 智能对象：AI 可交互点
			"Name": "SmartObjects",
			"Enabled": true
		},
		{
			// 67 情境动画： 翻越、开门
			"Name": "ContextualAnimation",
			"Enabled": true
		},
		{
			// 68 玩法行为 + 只能对象桥接
			"Name": "GameplayBehaviorSmartObjects",
			"Enabled": true
		},
		{
			// 69 玩法状态树
			"Name": "GameplayStateTree",
			"Enabled": true
		},
		{
			// 70 玩法行为框架
			"Name": "GameplayBehaviors",
			"Enabled": true
		}
	],
	"EpicSampleNameHash": "4517316834"
}

























